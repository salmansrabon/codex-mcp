{
  "name": "codex-mcp",
  "version": "1.0.0",
  "description": "Standalone, project-agnostic MCP server that uses Codex as an independent, read-only adversarial quality gate for test-design artifacts and bug findings.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "codex-mcp": "dist/bin/codex-mcp.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "codex-mcp.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/bin/codex-mcp.js start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "try": "node scripts/try-review.mjs"
  },
  "keywords": [
    "mcp",
    "codex",
    "qa",
    "test-design",
    "code-review",
    "quality-gate"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "which": "^5.0.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/which": "^3.0.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
